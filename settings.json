{
  "lastChangelogVersion": "0.85.1",
  "enableSkillCommands": true,
  "quietStartup": false,
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-context-view",
    "npm:pi-btw"
  ],
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "subagents": {
    "defaultProvider": "openai-codex",
    "defaultModel": "gpt-5.6-sol",
    "defaultThinking": "high",
    "maxThinking": "xhigh",
    "agentOverrides": {
      "scout": {
        "model": "gpt-5.6-sol",
        "thinking": "medium",
        "defaultContext": "fresh",
        "inheritProjectContext": true,
        "inheritGlobalContext": false
      },
      "researcher": {
        "model": "gpt-5.6-sol",
        "thinking": "high",
        "defaultContext": "fresh",
        "inheritProjectContext": true,
        "inheritGlobalContext": false
      },
      "worker": {
        "model": "gpt-5.6-sol",
        "thinking": "high",
        "defaultContext": "fork",
        "inheritProjectContext": true,
        "inheritGlobalContext": false
      },
      "reviewer": {
        "model": "gpt-6-astra",
        "thinking": "high",
        "defaultContext": "fresh",
        "inheritProjectContext": true,
        "inheritGlobalContext": false
      },
      "oracle": {
        "model": "gpt-5.6-astra",
        "thinking": "medium",
        "defaultContext": "fork",
        "inheritProjectContext": true,
        "inheritGlobalContext": false
      },
      "delegate": {
        "model": "gpt-5.6-luna",
        "thinking": "high",
        "defaultContext": "fresh",
        "inheritProjectContext": true,
        "inheritGlobalContext": false
      }
    }
  }
}


{
  "lastChangelogVersion": "0.99.1",
  "enableSkillCommands": true,
  "quietStartup": false,
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-context-view",
    "npm:pi-btw"
  ],
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "subagents": {
    "defaultProvider": "openai-codex",
    "defaultModel": "gpt-6.1-sol",
    "defaultThinking": "high",
    "maxThinking": "max",
    "agentOverrides": {
      "scout": {
        "model": "gpt-6-luna",
        "thinking": "max",
        "defaultContext": "fresh",
        "inheritProjectContext": true,
        "inheritGlobalContext": false
      },
      "researcher": {
        "model": "gpt-6.1-sol",
        "thinking": "high",
        "defaultContext": "fresh",
        "inheritProjectContext": true,
        "inheritGlobalContext": false
      },
      "worker": {
        "model": "gpt-6.1-sol",
        "thinking": "high",
        "defaultContext": "fresh",
        "inheritProjectContext": true,
        "inheritGlobalContext": false
      },
      "reviewer": {
        "model": "gpt-6-astra",
        "thinking": "medium",
        "defaultContext": "fresh",
        "inheritProjectContext": true,
        "inheritGlobalContext": false
      },
      "oracle": {
        "model": "gpt-6-astra",
        "thinking": "medium",
        "defaultContext": "fresh",
        "inheritProjectContext": true,
        "inheritGlobalContext": false
      },
      "delegate": {
        "model": "gpt-6.1-sol",
        "thinking": "high",
        "defaultContext": "fresh",
        "inheritProjectContext": true,
        "inheritGlobalContext": false
      }
    }
  },
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-luna"
  ]
}

